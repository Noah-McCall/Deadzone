BLACK = (5, 8, 7)
WHITE = (230, 235, 220)
GREEN = (45, 100, 55)
CYAN = (70, 230, 220)
RED = (210, 45, 45)
YELLOW = (240, 210, 90)
PURPLE = (180, 100, 230)

font = pygame.font.Font(None, 28)
small = pygame.font.Font(None, 21)
big = pygame.font.Font(None, 68)

MENU = "menu"
DIFFICULTY = "difficulty"
PLAYING = "playing"
PAUSED = "paused"
GAME_OVER = "game_over"
VICTORY = "victory"
HELP = "help"

state = MENU
difficulty = "NORMAL"

player = pygame.Rect(100, 100, 22, 22)

health = 100
stamina = 100
battery = 100
score = 0
identified = 0
captured = 0

selected_tool = 0
flashlight = False
message = "Welcome to the Dead Zone."

tools = [
    "Laser Scanner",
    "Ultraviolet",
    "Headgear Light",
    "Meat Bait",
    "Plant Sample",
    "Radio Scanner",
    "Bear Trap"
]

traits = [
    "Carnivore",
    "Herbivore",
    "Micro",
    "Nocturnal",
    "Radioactive"
]

difficulty_settings = {
    "EASY": (100, 0.45, 1),
    "NORMAL": (80, 0.75, 2),
    "HARD": (60, 1.15, 3)
}

trees = [
    (
        random.randint(0, WIDTH),
        random.randint(0, WORLD_H),
        random.randint(8, 20)
    )
    for _ in range(170)
]

plant = pygame.Rect(650, 55, 230, 165)

specimens = []
supplies = []


# =====================================
# TEXT AND BUTTONS
# =====================================

def text(value, x, y, color=WHITE, f=font):
    image = f.render(str(value), True, color)
    screen.blit(image, (x, y))


def button(label, rect, mouse):
    color = (45, 75, 48)

    if rect.collidepoint(mouse):
        color = (80, 130, 85)

    pygame.draw.rect(
        screen, color, rect, border_radius=8
    )

    pygame.draw.rect(
        screen, WHITE, rect, 2, border_radius=8
    )

    image = font.render(label, True, WHITE)

    screen.blit(
        image,
        image.get_rect(center=rect.center)
    )

    return rect.collidepoint(mouse)


# =====================================
# RESET AND GENERATE GAME
# =====================================

def reset_game():
    global health, stamina, battery
    global score, identified, captured
    global specimens, supplies, player
    global message, selected_tool, flashlight

    health = difficulty_settings[difficulty][0]
    stamina = 100
    battery = 100

    score = 0
    identified = 0
    captured = 0

    player = pygame.Rect(100, 100, 22, 22)

    selected_tool = 0
    flashlight = False

    specimens = []
    supplies = []

    message = "Mission 1: Investigate the abandoned facility."

    for i in range(30):

        while True:
            x = random.randint(40, WIDTH - 40)
            y = random.randint(40, WORLD_H - 40)

            if not plant.inflate(30, 30).collidepoint(x, y):
                break

        specimens.append({
            "id": i + 1,
            "x": float(x),
            "y": float(y),
            "traits": set(random.sample(traits, 3)),
            "evidence": {},
            "identified": False,
            "captured": False,
            "hostile": random.random() < 0.35,
            "phase": random.random() * math.tau,
            "direction": random.random() * math.tau,
            "speed": random.uniform(0.3, 0.7)
        })

    for i in range(12):
        supplies.append({
            "x": random.randint(40, WIDTH - 40),
            "y": random.randint(40, WORLD_H - 40),
            "type": random.choice([
                "health", "battery", "stamina"
            ]),
            "collected": False
        })


# =====================================
# SPECIMEN DISTANCE AND TARGETING
# =====================================

def distance(s):
    return math.hypot(
        player.centerx - s["x"],
        player.centery - s["y"]
    )


def nearest_specimen(limit=100):
    choices = [
        s for s in specimens
        if not s["captured"] and distance(s) < limit
    ]

    return min(choices, key=distance) if choices else None


