# =====================================
# RESEARCH SYSTEM
# =====================================

def use_tool():
    global message, identified, captured
    global score, flashlight

    if selected_tool == 2:
        flashlight = not flashlight
        message = "Headgear light switched."
        return

    specimen = nearest_specimen(
        180 if selected_tool == 0 else 85
    )

    if specimen is None:
        message = "No specimen within range."
        return

    if selected_tool == 0:
        message = (
            f"Scanner detected specimen #{specimen['id']}."
        )
        return

    if selected_tool == 1:
        trait = "Micro"

    elif selected_tool == 3:
        trait = "Carnivore"

    elif selected_tool == 4:
        trait = "Herbivore"

    elif selected_tool == 5:
        trait = "Radioactive"

    elif selected_tool == 6:

        if not specimen["identified"]:
            message = "Collect two positive tests first!"
            return

        specimen["captured"] = True
        captured += 1
        score += 100

        message = "Specimen captured! +100 points."
        return

    else:
        return

    result = trait in specimen["traits"]

    specimen["evidence"][trait] = result

    if result:
        message = f"POSITIVE: {trait} detected!"
    else:
        message = f"NEGATIVE: No {trait} detected."

    if sum(specimen["evidence"].values()) >= 2:

        if not specimen["identified"]:
            specimen["identified"] = True
            identified += 1
            score += 50

            message = "SPECIMEN IDENTIFIED! +50 points."


# =====================================
# SUPPLY SYSTEM
# =====================================

def update_supplies():
    global health, battery, stamina
    global score, message

    for item in supplies:

        if item["collected"]:
            continue

        rect = pygame.Rect(
            item["x"] - 9,
            item["y"] - 9,
            18, 18
        )

        if player.colliderect(rect):

            item["collected"] = True
            score += 20

            if item["type"] == "health":
                health = min(100, health + 30)
                message = "Medical supplies collected!"

            elif item["type"] == "battery":
                battery = min(100, battery + 35)
                message = "Flashlight battery restored!"

            else:
                stamina = 100
                message = "Energy supplies collected!"


# =====================================
# SPECIMEN AI
# =====================================

def update_specimens(dt):
    global health

    difficulty_speed = difficulty_settings[difficulty][1]

    for s in specimens:

        if s["captured"]:
            continue

        s["phase"] += 0.05 * dt

        d = distance(s)

        if s["hostile"] and d < 220:

            angle = math.atan2(
                player.centery - s["y"],
                player.centerx - s["x"]
            )

            s["x"] += (
                math.cos(angle) * difficulty_speed * dt
            )

            s["y"] += (
                math.sin(angle) * difficulty_speed * dt
            )

            if d < 24:
                health -= (
                    difficulty_settings[difficulty][2]
                    * 0.12 * dt
                )

        else:

            if random.random() < 0.025 * dt:
                s["direction"] += random.uniform(-1, 1)

            s["x"] += (
                math.cos(s["direction"])
                * s["speed"] * dt
            )

            s["y"] += (
                math.sin(s["direction"])
                * s["speed"] * dt
            )

        s["x"] = max(15, min(WIDTH - 15, s["x"]))
        s["y"] = max(15, min(WORLD_H - 15, s["y"]))


# =====================================
# WORLD GRAPHICS
# =====================================

def draw_world():
    screen.fill((22, 36, 25))

    for x, y, size in trees:

        color = random.choice([
            (15, 37, 22),
            (22, 48, 27),
            (29, 59, 33)
        ])

        pygame.draw.rect(
            screen, color,
            (x, y, size, size)
        )

    pygame.draw.rect(
        screen, (55, 65, 55), plant
    )

    pygame.draw.rect(
        screen, BLACK, plant, 4
    )

    text(
        "RESTRICTED FACILITY",
        672, 30, RED, small
    )

    text(
        "ABANDONED PLANT",
        672, 190, YELLOW, small
    )


# =====================================
# DRAW SPECIMENS
# =====================================

def draw_specimens():

    for s in specimens:

        if s["captured"]:
            continue

        x, y = int(s["x"]), int(s["y"])
        d = distance(s)

        visible = (
            d < 140
            or flashlight
            or selected_tool in (0, 1, 5)
        )

        if visible:

            pulse = int(math.sin(s["phase"]) * 3)

            color = RED if s["hostile"] else CYAN

            pygame.draw.circle(
                screen, color,
                (x, y), 7 + pulse
            )

            pygame.draw.circle(
                screen, WHITE,
                (x, y), 2
            )


# =====================================
# DRAW SUPPLIES
# =====================================

def draw_supplies():

    for item in supplies:

        if item["collected"]:
            continue

        color = {
            "health": RED,
            "battery": YELLOW,
            "stamina": GREEN
        }[item["type"]]

        pygame.draw.rect(
            screen, color,
            (item["x"] - 7, item["y"] - 7, 14, 14)
        )


# =====================================
# DARKNESS AND FLASHLIGHT
# =====================================

def draw_lighting():

    darkness = pygame.Surface(
        (WIDTH, WORLD_H),
        pygame.SRCALPHA
    )

    darkness.fill((0, 0, 0, 175))

    radius = 155 if flashlight else 90

    pygame.draw.circle(
        darkness,
        (0, 0, 0, 0),
        player.center,
        radius
    )

    screen.blit(darkness, (0, 0))


# =====================================
# HUD
# =====================================

def draw_hud():

    y = WORLD_H

    pygame.draw.rect(
        screen, (8, 13, 10),
        (0, y, WIDTH, HUD)
    )

    pygame.draw.line(
        screen, GREEN,
        (0, y), (WIDTH, y), 2
    )

    text(
        f"TOOL: {tools[selected_tool]}",
        15, y + 8, YELLOW
    )

    text(
        message[:75],
        15, y + 35, WHITE, small
    )

    text(
        f"HEALTH: {int(health)}",
        650, y + 8, RED, small
    )

    text(
        f"STAMINA: {int(stamina)}",
        650, y + 29, GREEN, small
    )

    text(
        f"BATTERY: {int(battery)}",
        650, y + 50, YELLOW, small
    )

    text(
        f"IDENTIFIED: {identified}/30",
        15, y + 65, CYAN, small
    )

    text(
        f"CAPTURED: {captured}/30",
        250, y + 65, YELLOW, small
    )

    text(
        f"SCORE: {score}",
        480, y + 65, WHITE, small
    )

    text(
        "WASD: MOVE | SHIFT: SPRINT | E: USE | 1-7: TOOLS | P: PAUSE",
        15, y + 88, WHITE, small
    )

    # =====================================
# MAIN GAME LOOP
# =====================================

running = True

while running:

    dt = min(clock.tick(60) / 16.67, 2)

    mouse_clicked = False
    mouse_position = pygame.mouse.get_pos()

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN:

            if event.button == 1:
                mouse_clicked = True
                mouse_position = event.pos

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:

                if state == PLAYING:
                    state = PAUSED

                elif state == PAUSED:
                    state = PLAYING

                elif state != MENU:
                    state = MENU

                else:
                    running = False

            if state == PLAYING:

                if event.key == pygame.K_p:
                    state = PAUSED

                if pygame.K_1 <= event.key <= pygame.K_7:
                    selected_tool = event.key - pygame.K_1

                if event.key == pygame.K_e:
                    use_tool()

            elif state == PAUSED:

                if event.key == pygame.K_p:
                    state = PLAYING

    # =================================
    # MAIN MENU
    # =================================

    if state == MENU:

        new_rect, help_rect, quit_rect = draw_menu()

        if mouse_clicked:

            if new_rect.collidepoint(mouse_position):
                state = DIFFICULTY

            elif help_rect.collidepoint(mouse_position):
                state = HELP

            elif quit_rect.collidepoint(mouse_position):
                running = False

    # =================================
    # DIFFICULTY SELECTION
    # =================================

    elif state == DIFFICULTY:

        rects = draw_difficulty()

        if mouse_clicked:

            options = ["EASY", "NORMAL", "HARD"]

            for i, rect in enumerate(rects):

                if rect.collidepoint(mouse_position):

                    difficulty = options[i]

                    reset_game()

                    state = PLAYING

    # =================================
    # HELP MENU
    # =================================

    elif state == HELP:

        rect = draw_help()

        if mouse_clicked and rect.collidepoint(mouse_position):
            state = MENU

    # =================================
    # GAMEPLAY
    # =================================

    elif state == PLAYING:

        keys = pygame.key.get_pressed()

        dx = (
            int(keys[pygame.K_d] or keys[pygame.K_RIGHT])
            - int(keys[pygame.K_a] or keys[pygame.K_LEFT])
        )

        dy = (
            int(keys[pygame.K_s] or keys[pygame.K_DOWN])
            - int(keys[pygame.K_w] or keys[pygame.K_UP])
        )

        sprinting = (
            keys[pygame.K_LSHIFT]
            or keys[pygame.K_RSHIFT]
        ) and stamina > 0 and (dx or dy)

        movement_speed = 5 if sprinting else 3

        if sprinting:
            stamina = max(0, stamina - 0.35 * dt)

        else:
            stamina = min(100, stamina + 0.2 * dt)

        if dx and dy:
            dx *= 0.707
            dy *= 0.707

        player.x += round(dx * movement_speed * dt)
        player.y += round(dy * movement_speed * dt)

        player.clamp_ip(
            pygame.Rect(0, 0, WIDTH, WORLD_H)
        )

        # FLASHLIGHT BATTERY

        if flashlight:

            battery = max(0, battery - 0.06 * dt)

            if battery <= 0:
                flashlight = False
                message = "Flashlight battery depleted!"

        # UPDATE GAME SYSTEMS

        update_specimens(dt)
        update_supplies()

        # CHECK GAME END

        if health <= 0:
            health = 0
            state = GAME_OVER

        elif captured >= 30 and identified >= 30:
            state = VICTORY

        # DRAW WORLD

        draw_world()
        draw_supplies()
        draw_specimens()

        # DRAW PLAYER

        pygame.draw.rect(
            screen,
            (30, 80, 40),
            player
        )

        pygame.draw.rect(
            screen,
            WHITE,
            player,
            2
        )

        # DRAW LIGHTING

        draw_lighting()

        # DRAW HUD

        draw_hud()

    # =================================
    # PAUSE SCREEN
    # =================================

    elif state == PAUSED:

        draw_world()
        draw_specimens()

        overlay = pygame.Surface(
            (WIDTH, HEIGHT),
            pygame.SRCALPHA
        )

        overlay.fill((0, 0, 0, 190))

        screen.blit(overlay, (0, 0))

        text(
            "GAME PAUSED",
            340, 230, YELLOW, big
        )

        text(
            "Press P or ESC to resume",
            355, 330, WHITE
        )

    # =================================
    # GAME OVER
    # =================================

    elif state == GAME_OVER:

        rect = draw_end(
            "YOU DIED",
            "The Dead Zone claimed another researcher."
        )

        if mouse_clicked and rect.collidepoint(mouse_position):
            state = MENU

    # =================================
    # VICTORY
    # =================================

    elif state == VICTORY:

        rect = draw_end(
            "MISSION COMPLETE",
            "All specimens have been researched and captured."
        )

        if mouse_clicked and rect.collidepoint(mouse_position):
            state = MENU

    pygame.display.flip()


# =====================================
# EXIT
# =====================================

pygame.quit()
sys.exit()